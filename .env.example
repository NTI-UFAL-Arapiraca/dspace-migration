# PostgreSQL — banco de origem (Odoo/legado)
DB_HOST=localhost
DB_PORT=5440
DB_NAME=biblioteca
DB_USER=postgres
DB_PASSWORD=postgres

# Diretório local do SAF bundle (relativo à raiz do projeto)
SAF_BUNDLE_DIR=saf_bundle

# O projeto irmão dspace-bca tem seu próprio arquivo de ambiente. Configure
# nele DSPACE_SAF_HOST_DIR com o caminho absoluto da mesma pasta usada por
# SAF_BUNDLE_DIR aqui. Este valor é uma referência, não altera o outro .env.
DSPACE_SAF_HOST_DIR=/caminho/absoluto/saf_bundle

# Quantidade de PDFs buscados do banco por query (evita consumo excessivo de memória no container Postgres e no Python)
BATCH_SIZE=50

# Tempo máximo, em segundos, para cada conversão PDF/A pelo Ghostscript
GS_TIMEOUT=300

# API REST do DSpace (cria a hierarquia e aplica as datas de embargo)
DSPACE_API_URL=http://localhost:8080/server/api
DSPACE_API_USER=test@test.edu
DSPACE_API_PASSWORD=admin

# Coleção bibliográfica com tipo Person (UUID), sem contas de acesso.
# scripts/prepare-academic.sh do dspace-bca salva este UUID automaticamente.
# Consulte docs/5_pessoas_e_vinculos.md e o guia da implantação.
DSPACE_PERSON_COLLECTION_UUID=

# Nome público exibido pela interface, inclusive nos títulos de estatísticas
DSPACE_NAME=Repositório Institucional da UFAL

# URLs públicas usadas pelo backend para gerar links, respostas OAI e
# identificadores. Em produção, substitua localhost pelo domínio HTTPS.
DSPACE_SERVER_URL=http://localhost:8080/server
DSPACE_UI_URL=http://localhost:4000
DSPACE_ADMIN_EMAIL=test@test.edu

# OAI-PMH fica disponível em {DSPACE_SERVER_URL}/{OAI_PATH}/request
OAI_ENABLED=true
OAI_PATH=oai

# Agendamento Quartz da atualização dos sitemaps (diariamente às 01:15)
SITEMAP_CRON=0 15 1 * * ?

# O health check SEO precisa alcançar DSPACE_UI_URL a partir do backend.
# Use false com localhost e true apenas no ambiente público resolvível.
SEO_HEALTH_ENABLED=false

# Caminho absoluto no host para o banco MaxMind GeoLite2 City (formato MMDB).
# Baixe e atualize o arquivo conforme os termos da MaxMind; não o comite.
GEOLITE2_CITY_DB_PATH=/caminho/absoluto/GeoLite2-City.mmdb

# Todos os serviços oficiais acompanham a linha de manutenção mais recente do
# DSpace 10. Não use latest/latest-test: esses aliases podem avançar para o 11.
DSPACE_VER=dspace-10.1
DSPACE_ANGULAR_TAG=dspace-10.1
DSPACE_ANGULAR_IMAGE=dspace-migration-angular

# ─────────────────────────────────────────────────────────────────────────────
# Configurações para migração de estatísticas (inject-stats)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — banco do DSpace (para resolver handle → UUID)
DSPACE_DB_HOST=localhost
DSPACE_DB_PORT=5432
DSPACE_DB_NAME=dspace
DSPACE_DB_USER=dspace
DSPACE_DB_PASSWORD=dspace

# Solr — URL base do DSpace (core statistics será acessado como {SOLR_URL}/statistics)
SOLR_URL=http://localhost:8983/solr

# Tamanho dos lotes de documentos enviados ao Solr por requisição
SOLR_BATCH_SIZE=500
