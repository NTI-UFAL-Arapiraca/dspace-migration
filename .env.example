# PostgreSQL — banco de origem (Odoo/legado)
DB_HOST=localhost
DB_PORT=5440
DB_NAME=biblioteca
DB_USER=postgres
DB_PASSWORD=postgres

# Diretório local do SAF bundle (relativo à raiz do projeto)
SAF_BUNDLE_DIR=saf_bundle

# Tamanho do lote de registros por busca (evita sobrecarregar a memória RAM)
BATCH_SIZE=100
