ARG DSPACE_ANGULAR_TAG=dspace-10.1

# The non-dist image contains the matching DSpace Angular source, dependencies,
# and the official src/themes/custom extension point.
FROM docker.io/dspace/dspace-angular:${DSPACE_ANGULAR_TAG} AS build

WORKDIR /app

# A first visit without dsLanguage must use the repository default instead of
# inheriting the browser's Accept-Language before the UI has initialized.
COPY frontend/patches/apply-default-anonymous-language.mjs \
    /tmp/apply-default-anonymous-language.mjs
RUN node /tmp/apply-default-anonymous-language.mjs \
    /app/src/app/core/locale/locale.service.ts

# Public responses are locale-filtered by DSpace REST. Keep allLanguages
# restricted to the administrative metadata editor and its PATCH responses.
COPY frontend/overrides/edit-item-all-languages.resolver.ts \
    /app/src/app/item-page/edit-item-page/edit-item-all-languages.resolver.ts
COPY frontend/patches/apply-item-all-languages.mjs /tmp/apply-item-all-languages.mjs
RUN node /tmp/apply-item-all-languages.mjs \
    /app/src/app/core/data/item-data.service.ts \
    /app/src/app/item-page/edit-item-page/edit-item-page-routes.ts

# Keep the crawler policy under version control. Express renders the public UI
# origin into this EJS template and serves it at the top-level /robots.txt.
COPY frontend/overrides/robots.txt.ejs /app/src/robots.txt.ejs

# Merge the locally maintained theme and its component registries into the
# official source tree. Files not overridden here remain inherited from the
# version-matched base image.
COPY frontend/themes/ /app/src/themes/

# Merge the labels maintained by the custom theme into the standard language
# bundles before Angular calculates their production hashes.
RUN npm run merge-i18n -- -s src/themes/custom/assets/i18n \
    && npm run build:prod

# Keep the official production entrypoint (PM2) and replace only its compiled
# distribution with the one containing our custom theme.
FROM docker.io/dspace/dspace-angular:${DSPACE_ANGULAR_TAG}-dist AS runtime

COPY --chown=node:node --from=build /app/dist /app/dist
