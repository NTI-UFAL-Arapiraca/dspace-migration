ARG DSPACE_ANGULAR_TAG=dspace-10_x

# The non-dist image contains the matching DSpace Angular source, dependencies,
# and the official src/themes/custom extension point.
FROM docker.io/dspace/dspace-angular:${DSPACE_ANGULAR_TAG} AS build

WORKDIR /app

# DSpace REST filters metadata by its current locale unless the allLanguages
# projection is requested. Patch the item data service before compiling so
# public item pages and the metadata editor receive every language variant.
COPY frontend/patches/apply-item-all-languages.mjs /tmp/apply-item-all-languages.mjs
RUN node /tmp/apply-item-all-languages.mjs /app/src/app/core/data/item-data.service.ts

# Merge the locally maintained theme and its component registries into the
# official source tree. Files not overridden here remain inherited from the
# version-matched base image.
COPY frontend/themes/ /app/src/themes/

# Merge the labels maintained by the custom theme into the standard language
# bundles before Angular calculates their production hashes.
RUN npm run merge-i18n -- -s src/themes/custom/assets/i18n \
    && npm run build:prod

# Keep the official production entrypoint (PM2) and replace only its compiled
# distribution with the one containing our custom theme.
FROM docker.io/dspace/dspace-angular:${DSPACE_ANGULAR_TAG}-dist AS runtime

COPY --chown=node:node --from=build /app/dist /app/dist
